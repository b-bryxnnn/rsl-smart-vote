// RSL Smart Vote - Prisma Schema for PostgreSQL
// Version 2.0 - With Security & User Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// USERS & AUTHENTICATION
// =====================================================

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  displayName  String?    @map("display_name")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastLogin    DateTime?  @map("last_login")

  sessions     Session[]
  tokens       Token[]    @relation("ActivatedBy")

  @@map("users")
}

enum UserRole {
  admin
  committee
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  sessionToken String    @unique @map("session_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime? @map("expires_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// =====================================================
// ACTIVITY LOGGING
// =====================================================

model ActivityLog {
  id           Int       @id @default(autoincrement())
  action       String
  details      String?
  userId       Int?      @map("user_id")
  userUsername String?   @map("user_username")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}

// =====================================================
// SYSTEM SETTINGS
// =====================================================

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model RateLimit {
  id           Int      @id @default(autoincrement())
  identifier   String
  action       String
  attemptCount Int      @default(1) @map("attempt_count")
  windowStart  DateTime @default(now()) @map("window_start")

  @@index([identifier, action])
  @@map("rate_limits")
}

// =====================================================
// CORE TABLES
// =====================================================

model Student {
  id         Int         @id @default(autoincrement())
  studentId  String      @unique @map("student_id")
  prefix     String
  firstName  String      @map("first_name")
  lastName   String      @map("last_name")
  level      String
  room       String?
  voteStatus VoteStatus? @map("vote_status")
  votedAt    DateTime?   @map("voted_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([studentId])
  @@index([voteStatus])
  @@map("students")
}

enum VoteStatus {
  voted
  absent
}

model Party {
  id        Int      @id @default(autoincrement())
  name      String
  number    Int      @unique
  createdAt DateTime @default(now()) @map("created_at")

  votes     Vote[]

  @@map("parties")
}

model Token {
  id              Int          @id @default(autoincrement())
  code            String       @unique
  status          TokenStatus  @default(inactive)
  stationLevel    String?      @map("station_level")
  printBatchId    String?      @map("print_batch_id")
  studentId       String?      @map("student_id")
  activatedBy     Int?         @map("activated_by")
  activatedAt     DateTime?    @map("activated_at")
  votingStartedAt DateTime?    @map("voting_started_at")
  usedAt          DateTime?    @map("used_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  activatedByUser User?        @relation("ActivatedBy", fields: [activatedBy], references: [id])
  vote            Vote?

  @@index([code])
  @@index([status])
  @@index([activatedAt])
  @@map("tokens")
}

enum TokenStatus {
  inactive
  activated
  voting
  used
  expired
}

model Vote {
  id           Int      @id @default(autoincrement())
  partyId      Int?     @map("party_id")
  stationLevel String   @map("station_level")
  tokenId      Int      @unique @map("token_id")
  isAbstain    Int      @default(0) @map("is_abstain")
  createdAt    DateTime @default(now()) @map("created_at")

  party        Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  token        Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("votes")
}

model PrintLog {
  id           Int      @id @default(autoincrement())
  batchId      String   @map("batch_id")
  tokenCount   Int      @map("token_count")
  stationLevel String?  @map("station_level")
  printedAt    DateTime @default(now()) @map("printed_at")
  printedBy    String?  @map("printed_by")

  @@map("print_logs")
}
